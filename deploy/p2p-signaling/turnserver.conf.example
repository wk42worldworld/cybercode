listening-port=3478
listening-ip=0.0.0.0
relay-ip=10.3.4.11
external-ip=43.160.249.187/10.3.4.11
min-port=49160
max-port=49200

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_SECRET_AS_CYBERCODE_P2P_TURN_SECRET
realm=www.mybotworld.com
stale-nonce=600

total-quota=200
user-quota=8
no-cli
no-multicast-peers
no-tls
no-dtls
log-file=syslog
simple-log

# Prevent the public relay from reaching services on private networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
